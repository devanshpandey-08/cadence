{
  "name": "cadence-enterprise-backend",
  "version": "2.0.0",
  "description": "Cadence Marketing OS - Enterprise Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "docker:build": "docker build -t cadence-api:latest .",
    "docker:up": "docker-compose up -d",
    "k8s:deploy": "kubectl apply -f ../infrastructure/kubernetes/"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "kysely": "^0.27.4",
    "kysely-postgres-js": "^2.0.1",
    "redis": "^4.7.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.24.0",
    "langchain": "^0.2.10",
    "@langchain/core": "^0.2.15",
    "nodemailer": "^6.9.14",
    "@sendgrid/mail": "^8.1.3",
    "aws-sdk": "^2.1646.0",
    "sharp": "^0.33.4",
    "csv-parse": "^5.5.6",
    "json2csv": "^6.0.0-alpha.2",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "rate-limiter-flexible": "^5.0.3",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.0.0",
    "stripe": "^16.5.0",
    "socket.io": "^4.7.5",
    "graphql": "^16.9.0",
    "express-graphql": "^0.12.0",
    "prom-client": "^15.1.3",
    "opentelemetry-api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "tsc-alias": "^1.8.10",
    "eslint": "^9.8.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "vitest": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "docker-compose": "^0.24.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "volta": {
    "node": "20.15.1"
  }
}
